// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  role         Role   @default(USER)
  passwordHash String
  cliente      Cliente?
}

model Cliente {
  id         String      @id @default(uuid())
  userId     String      @unique
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  lastName   String
  domicilios Domicilio[]
}

model Domicilio {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  direccion String
  etiqueta  String? @db.VarChar(100)

  @@index([clienteId])
}

enum TipoPuntoLimpio {
  PUNTO_LIMPIO
  BOTELLERO
  BOTELLERO_LATERO
}
model PuntoLimpio {
  id        String @id @default(uuid())
  nombre    String
  tipo      TipoPuntoLimpio
  direccion String
  lat       Float
  long      Float
  residuos PuntoLimpioResiduo[]

}

model Residuo {
  id            String @id @default(uuid())
  nombre        String @unique
  puntosLimpios PuntoLimpioResiduo[]
}
model PuntoLimpioResiduo {
  puntoLimpioId String
  residuoId     String

  puntoLimpio PuntoLimpio @relation(fields: [puntoLimpioId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  residuo Residuo @relation(fields: [residuoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([puntoLimpioId, residuoId])
  @@index([residuoId])
  @@map("_PuntoLimpioToResiduo")
}
