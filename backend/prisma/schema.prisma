// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  name         String
  lastName     String
  passwordHash String
}

enum TipoPuntoLimpio {
  PUNTO_LIMPIO
  BOTELLERO
  BOTELLERO_LATERO
}
model PuntoLimpio {
  id        String @id @default(uuid())
  nombre    String
  tipo      TipoPuntoLimpio
  direccion String
  lat       Float
  long      Float
  residuos  Residuo[]
}

model Residuo {
  id            String @id @default(uuid())
  nombre        String @unique
  puntosLimpios PuntoLimpio[]
}