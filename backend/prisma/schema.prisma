// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  role         Role     @default(USER)
  passwordHash String
  cliente      Cliente?
}

model Cliente {
  id         String             @id @default(uuid())
  userId     String             @unique
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  lastName   String
  domicilios ClienteDireccion[]
}

model Calle {
  id          String      @id @default(uuid())
  calle       String
  clave       String      @unique
  direcciones Direccion[]
}

model Direccion {
  id             String             @id @default(uuid())
  calleId        String
  calle          Calle              @relation(fields: [calleId], references: [id], onDelete: Restrict)
  altura         Int
  lat            Float
  long           Float
  domicilios     ClienteDireccion[]
  puntosLimpios  PuntoLimpio[]
  puntosTrayecto PuntoTrayecto[]

  @@unique([calleId, altura])
}

model ClienteDireccion {
  clienteId   String
  direccionId String
  etiqueta    String?   @db.VarChar(100)
  cliente     Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  direccion   Direccion @relation(fields: [direccionId], references: [id], onDelete: Restrict)

  @@id([clienteId, direccionId])
  @@index([direccionId])
}

model TipoPuntoLimpio {
  id            String                   @id @default(uuid())
  nombre        String                   @unique
  puntosLimpios PuntoLimpio[]
  residuos      TipoPuntoLimpioResiduo[]
}

model PuntoLimpio {
  id          String          @id @default(uuid())
  nombre      String
  tipoId      String
  tipo        TipoPuntoLimpio @relation(fields: [tipoId], references: [id])
  direccionId String
  direccion   Direccion       @relation(fields: [direccionId], references: [id])

  @@index([tipoId])
  @@index([direccionId])
}

model Residuo {
  id               String                   @id @default(uuid())
  nombre           String                   @unique
  tiposPuntoLimpio TipoPuntoLimpioResiduo[]
}

model TipoPuntoLimpioResiduo {
  tipoPuntoLimpioId String
  residuoId         String

  tipoPuntoLimpio TipoPuntoLimpio @relation(fields: [tipoPuntoLimpioId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  residuo         Residuo         @relation(fields: [residuoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([tipoPuntoLimpioId, residuoId])
  @@index([residuoId])
  @@map("_TipoPuntoLimpioToResiduo")
}

model Localidad {
  id        String     @id
  nombre    String
  trayectos Trayecto[]
}

model Trayecto {
  id          String          @id @default(uuid())
  nombre      String
  localidadId String
  localidad   Localidad       @relation(fields: [localidadId], references: [id])
  geometria   Json
  puntos      PuntoTrayecto[]

  @@index([localidadId])
}

model PuntoTrayecto {
  trayectoId  String
  trayecto    Trayecto  @relation(fields: [trayectoId], references: [id], onDelete: Cascade)
  orden       Int
  direccionId String
  direccion   Direccion @relation(fields: [direccionId], references: [id])

  @@id([trayectoId, orden])
  @@index([direccionId])
}

enum Estado {
  ACTIVO
  INACTIVO
}

model Conductor {
  id        String              @id @default(uuid())
  nombre    String
  apellido  String
  activo    Boolean             @default(true)
  contratos ContratoConductor[]
}

model ContratoConductor {
  idCamion    String
  idConductor String
  fechaInicio DateTime
  fechaFin    DateTime?

  camion    Camion    @relation(fields: [idCamion], references: [id], onDelete: Restrict)
  conductor Conductor @relation(fields: [idConductor], references: [id], onDelete: Restrict)

  @@id([idCamion, idConductor, fechaInicio])
  @@index([idCamion, fechaInicio])
  @@index([idConductor, fechaInicio])
}

model Camion {
  id        String              @id @default(uuid())
  marca     String
  modelo    String
  anio      Int
  estado    Estado              @default(ACTIVO)
  patente   String              @unique
  contratos ContratoConductor[]
}
