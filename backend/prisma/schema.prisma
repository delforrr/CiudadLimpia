// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  role         Role     @default(USER)
  passwordHash String
  cliente      Cliente?
}

model Cliente {
  id         String      @id @default(uuid())
  userId     String      @unique
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  lastName   String
  domicilios Direccion[]
}

model Calle {
  id          String      @id @default(uuid())
  calle       String
  clave       String      @unique
  direcciones Direccion[]
}

model Direccion {
  id            String        @id @default(uuid())
  clienteId     String?
  cliente       Cliente?      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  direccion     String?
  calleId       String?
  calle         Calle?        @relation(fields: [calleId], references: [id], onDelete: Restrict)
  altura        Int?
  lat           Float?
  long          Float?
  etiqueta      String?       @db.VarChar(100)
  puntosLimpios PuntoLimpio[]

  @@unique([calleId, altura])
  @@index([clienteId])
}

model TipoPuntoLimpio {
  id            String                   @id @default(uuid())
  nombre        String                   @unique
  puntosLimpios PuntoLimpio[]
  residuos      TipoPuntoLimpioResiduo[]
}

model PuntoLimpio {
  id          String          @id @default(uuid())
  nombre      String
  tipoId      String
  tipo        TipoPuntoLimpio @relation(fields: [tipoId], references: [id])
  direccionId String
  direccion   Direccion       @relation(fields: [direccionId], references: [id])
  lat         Float
  long        Float

  @@index([tipoId])
  @@index([direccionId])
}

model Residuo {
  id               String                   @id @default(uuid())
  nombre           String                   @unique
  tiposPuntoLimpio TipoPuntoLimpioResiduo[]
}

model TipoPuntoLimpioResiduo {
  tipoPuntoLimpioId String
  residuoId         String

  tipoPuntoLimpio TipoPuntoLimpio @relation(fields: [tipoPuntoLimpioId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  residuo         Residuo         @relation(fields: [residuoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([tipoPuntoLimpioId, residuoId])
  @@index([residuoId])
  @@map("_TipoPuntoLimpioToResiduo")
}
