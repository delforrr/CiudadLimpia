# API local (en producción usar NODE_ENV=production y HTTPS)
NODE_ENV=development
PORT=3000
FRONTEND_PORT=8080

# PostgreSQL local con Docker Compose
POSTGRES_USER=ciudadlimpia
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ciudadlimpia_db
POSTGRES_PORT=5432

# Usar aquí el mismo usuario, contraseña, puerto y base definidos arriba.
# Si la contraseña contiene símbolos, codificarlos para una URL.
DATABASE_URL="postgresql://ciudadlimpia:change_me@127.0.0.1:5432/ciudadlimpia_db?schema=public"
# Misma base desde los contenedores: nombre del servicio y puerto interno.
DATABASE_URL_DOCKER="postgresql://ciudadlimpia:change_me@postgres:5432/ciudadlimpia_db?schema=public"

# Generar un secreto aleatorio con: openssl rand -hex 32
JWT_SECRET=""

